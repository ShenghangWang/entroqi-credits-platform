{
  "name": "reusable-credits-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable, pluggable billing and credits platform module.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "install:console": "npm --prefix back-office ci --ignore-scripts",
    "build": "npm run build:server && npm run build:console",
    "build:server": "node scripts/build.mjs",
    "build:console": "npm --prefix back-office run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\"",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node -r dotenv/config scripts/migrate-mysql.cjs",
    "db:rollback": "node -r dotenv/config scripts/migrate-mysql.cjs --down",
    "db:status": "node -r dotenv/config scripts/db-status.cjs",
    "verify:pricing-ui": "node scripts/verify-pricing-console.mjs --full-ui",
    "verify:pricing-contract": "node scripts/verify-pricing-console.mjs",
    "company:register": "node -r dotenv/config scripts/register-company-apps.cjs",
    "staff:credentials": "node scripts/staff-credentials.mjs",
    "verify:owners-ui": "node scripts/verify-owner-console.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "6.1.2",
    "dotenv": "^16.5.0",
    "fastify": "5.12.7",
    "mysql2": "3.23.1",
    "qrcode": "^1.5.4",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "5.0.5",
    "playwright": "1.61.0"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "14.0.2"
    }
  }
}
