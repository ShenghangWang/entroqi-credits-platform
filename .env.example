NODE_ENV=development
# Production requires a dedicated non-root DB user and an explicit password of at least16characters.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3310
MYSQL_DATABASE=entroqi_billing
MYSQL_USER=credits
MYSQL_PASSWORD=credits
MYSQL_CONNECTION_LIMIT=10
PAYMENT_CALLBACK_SECRET=local_dev_payment_secret

# Optional machine/automation pricing credentials; no separate UI.
# Interactive owner/manager pricing uses pricingPermissions on staff operators.
CREDITS_PRICING_OPERATORS=[]
CREDITS_PLATFORM_OPERATORS=[]

# Build the original private Vue console and configure its absolute dist directory.
CREDITS_CONSOLE_DIRECTORY=
CREDITS_CONSOLE_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
CREDITS_AGENT_WORKFLOWS_ENABLED=false

# Highest-privilege emergency recovery: authoritative owner-only JSON secret file.
# Empty keeps legacy environment-only mode (no hot rotation). Initialize via
# npm run staff:credentials -- init --file /absolute/private/staff-operators.json
CREDITS_PLATFORM_OPERATORS_FILE=
# Optional verified company account UI; reuse its existing Better Auth reset.
CREDITS_COMPANY_ACCOUNT_RECOVERY_URL=

# Owner recovery: keep recipient/key private. Staging does not verify the address.
CREDITS_OWNER_RECOVERY_EMAIL=
CREDITS_OWNER_RECOVERY_SECRET=
# Reuse the company transactional-mail provider only after sender qualification.
CREDITS_RECOVERY_MAIL_PROVIDER=resend
CREDITS_RECOVERY_MAIL_FROM=
CREDITS_RECOVERY_MAIL_API_KEY=
